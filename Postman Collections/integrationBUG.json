	"item": [
		{
			"name": "Login",
			"item": [
				{
					"name": "Initial Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"id": "6c0d0e20-f2a1-4f59-a039-7a9f16bbde0c",
								"exec": [
									"try {",
									"    const responseJson = pm.response.json();",
									"    console.log('Hello', responseJson);",
									"    console.log({responseJson});",
									"",
									"    if (pm.response.code !== 200) {",
									"        postman.setNextRequest(null);",
									"    }",
									"",
									"    pm.environment.set(\"admin_access_token\", responseJson.access_token)",
									"",
									"    pm.test(\"Should update access token successfully\", function () {",
									"        pm.response.to.have.status(200);",
									"    });",
									"} catch (err) {",
									"    console.log('Call to identity failed')",
									"    console.log({err});",
									"    postman.setNextRequest(null);",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"id": "3fe2f862-4483-4dd4-80ec-6ae7e7c8ccf3",
					"protocolProfileBehavior": {
						"disableCookies": true,
						"disableBodyPruning": true
					},
